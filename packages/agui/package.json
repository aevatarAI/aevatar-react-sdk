{
  "name": "@aevatar-react-sdk/agui",
  "version": "0.5.0",
  "description": "AGUI protocol client — SSE, WebSocket, event normalization, React hooks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "author": "AevatarAI",
  "license": "ISC",
  "keywords": ["aevatar", "agui", "agent-ui", "sse", "websocket", "react", "hooks", "workflow"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/*",
    "README.md"
  ],
  "homepage": "https://aevatar.ai/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aevatarAI/aevatar-react-sdk.git",
    "directory": "packages/agui"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest --coverage",
    "test:dev": "vitest --watch",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@aevatar-react-sdk/types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "latest",
    "@vitest/coverage-v8": "3.0.6",
    "vitest": "^3.0.6"
  }
}
